# Local development defaults only. These are NOT secrets worth protecting;
# copy this file to `.env` and keep the defaults, or change them if you like.
# Never reuse any of these values outside a local dev environment.

# --- Backend / Postgres ---
POSTGRES_DB=wordpress_estate
POSTGRES_USER=estate
POSTGRES_PASSWORD=estate-dev-password
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Seed agent credentials — the backend creates this agent on startup so the
# CLI agent / demo script can authenticate immediately without a manual step.
SEED_AGENT_ID=agent-demo
SEED_AGENT_SECRET=demo-agent-secret-change-me

# --- Frontend ---
FRONTEND_PORT=8080
VITE_API_URL=http://localhost:8001

# --- Redis / worker ---
REDIS_URL=redis://redis:6379/0

# --- MariaDB / WordPress sites ---
MARIADB_ROOT_PASSWORD=mariadb-root-dev-password
WORDPRESS_DB_USER=wpuser
WORDPRESS_DB_PASSWORD=wpuser-dev-password
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=AdminDemo123!
WP_ADMIN_EMAIL=admin@example.local
WP_PORT_BASE=8180
WP1_PORT=8181
WP2_PORT=8182
WP3_PORT=8183
WP4_PORT=8184
WP5_PORT=8185
